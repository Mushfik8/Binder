# ===========================================
# Binder — Environment Variables
# ===========================================
# Copy this to .env.local and fill in values.
# NEVER commit .env.local to version control.
# ===========================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://byxgzshnmcftwvmqayxg.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_F204CIpd1VE2Wk8gJxz5nA_sZd0QkYS
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Binder

# --- CAPTCHA (Cloudflare Turnstile) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# --- Feature Flags ---
NEXT_PUBLIC_ENABLE_LOCATION=true
NEXT_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=false
NEXT_PUBLIC_ENABLE_BRAND_TAGS=true

# --- Rate Limiting ---
RATE_LIMIT_AUTH_PER_MINUTE=5
RATE_LIMIT_SWIPES_PER_HOUR=100
RATE_LIMIT_MESSAGES_PER_MINUTE=30
RATE_LIMIT_UPLOADS_PER_HOUR=20
RATE_LIMIT_REPORTS_PER_DAY=10
